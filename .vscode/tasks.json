{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-G",
                "Visual Studio 18 2026",
                "-A",
                "x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "cmake: build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "cmake: configure",
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "cmake: build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "cmake: configure",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cmake: rebuild Debug (clean)",
            "type": "shell",
            "command": "cmake --build build --config Debug --clean-first",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "cmake: configure",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test: run unit tests (Debug)",
            "type": "shell",
            "command": "ctest --test-dir build -C Debug --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "cmake: build Debug",
            "problemMatcher": []
        },
        {
            "label": "test: run unit tests (Release)",
            "type": "shell",
            "command": "ctest --test-dir build -C Release --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "cmake: build Release",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
